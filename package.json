{
  "name": "club12-v2",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "ncu": "npx npm-check-updates@latest -i",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/payload-cloud": "3.94.2",
    "@payloadcms/richtext-lexical": "3.94.2",
    "@payloadcms/storage-s3": "3.94.2",
    "@payloadcms/ui": "3.94.2",
    "@tailwindcss/postcss": "4.3.5",
    "cross-env": "10.1.0",
    "dotenv": "18.0.10",
    "graphql": "17.1.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "payload": "3.94.2",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "daisyui": "5.8.3",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "mongodb": "6.20.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild",
    "unrs-resolver"
  ]
}
